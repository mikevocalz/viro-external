{
  "name": "viro-external-workspace",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "specs": "pnpm -r --if-present specs",
    "check:metro": "node scripts/check-metro-resolution.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "metro-resolver": "0.87.1"
  }
}
