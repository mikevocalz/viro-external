# Perfetto trace config for the 2026-10 device pass (CPU and GPU timelines).
# Pushed and run by capture-start.sh:
#   adb shell perfetto --txt -c /data/misc/perfetto-configs/viro-pass.pbtx \
#     -o /data/misc/perfetto-traces/<name>.pftrace --background
# Field names follow https://perfetto.dev/docs/ (TraceConfig, FtraceConfig,
# ProcessStatsConfig, AndroidPowerConfig, GpuCounterConfig).
# duration_ms caps a forgotten trace; capture-stop.sh ends it earlier.

buffers {
  size_kb: 131072
  fill_policy: RING_BUFFER
}
buffers {
  size_kb: 8192
  fill_policy: RING_BUFFER
}

data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_idle"
      ftrace_events: "power/gpu_frequency"
      ftrace_events: "power/suspend_resume"
      ftrace_events: "thermal/thermal_temperature"
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_categories: "sched"
      atrace_categories: "freq"
      atrace_categories: "power"
      atrace_apps: "*"
    }
  }
}

data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config {
      scan_all_processes_on_start: true
      proc_stats_poll_ms: 1000
    }
  }
}

data_sources {
  config {
    name: "linux.sys_stats"
    target_buffer: 1
    sys_stats_config {
      meminfo_period_ms: 1000
      meminfo_counters: MEMINFO_MEM_AVAILABLE
      meminfo_counters: MEMINFO_MEM_FREE
    }
  }
}

data_sources {
  config {
    name: "android.power"
    target_buffer: 1
    android_power_config {
      battery_poll_ms: 1000
      battery_counters: BATTERY_COUNTER_CAPACITY_PERCENT
      battery_counters: BATTERY_COUNTER_CURRENT
    }
  }
}

# Adreno render-stage and counter sources. A runtime that does not expose
# them ignores these blocks; the trace still records CPU scheduling.
data_sources {
  config {
    name: "gpu.renderstages"
    target_buffer: 0
  }
}
data_sources {
  config {
    name: "gpu.counters"
    target_buffer: 0
    gpu_counter_config {
      counter_period_ns: 1000000
    }
  }
}

data_sources {
  config {
    name: "android.log"
    target_buffer: 1
    android_log_config {
      log_ids: LID_DEFAULT
    }
  }
}

duration_ms: 660000
