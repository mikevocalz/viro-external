{
  "name": "@viro-external/specs",
  "version": "0.2.0-rc.1",
  "description": "Portable Viro scene and interaction adapter foundation for Snap Specs / Spectacles Lens Studio runtimes.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "lens",
    "scripts",
    "README.md",
    "doc",
    "upstream"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "specs:validate-lens": "node scripts/validate-lens-runtime.mjs",
    "specs:sync": "node scripts/sync-lens-runtime.mjs",
    "specs:doctor": "node scripts/doctor-lens-project.mjs",
    "specs:bootstrap": "node scripts/bootstrap-platform-lab.mjs",
    "specs:go": "node scripts/go-clad.mjs",
    "specs:test-runner": "node --test scripts/go-clad.test.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build && pnpm specs:validate-lens && pnpm specs:test-runner"
  },
  "peerDependencies": {
    "@viro-external/xr-contract": ">=0.2.0-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@viro-external/xr-contract": "workspace:*",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "smol-toml": "1.9.0"
  },
  "module": "dist/index.js"
}
