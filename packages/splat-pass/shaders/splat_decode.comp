#version 310 es
precision highp float;

// Splat temporal decode.
//
// Reads compressed splats from the static base block (SSBO 0) and, for
// 4D sources, the per-keyframe delta block (SSBO 1) and writes the live
// per-splat record into `decodedSplats[]` (SSBO 2). Static 3D sources
// run through the degenerate path (memcpy of the base block, ignoring
// the delta SSBO).
//
// Source format: 24-byte half-precision packed SPZ-compatible layout —
// pos.xyz (3 × f16), scale.xyz (3 × f16), rot.xyzw (4 × f16), col.rgba
// (4 × f16). Output stride: 64 bytes (see SplatBuffers.h).

#ifndef SPLAT_DECODE_LOCAL_SIZE
#define SPLAT_DECODE_LOCAL_SIZE 64
#endif

layout(local_size_x = SPLAT_DECODE_LOCAL_SIZE) in;

struct SrcSplat {
    uvec4 packed0;   // pos.xyz + scale.x (8 × f16)
    uvec4 packed1;   // scale.yz + rot.xyzw + col.rg (8 × f16)
    uvec2 packed2;   // col.ba + pad (4 × f16)
};

struct DstSplat {
    vec4 position;
    vec4 scale;
    vec4 rotation;
    vec4 color;
};

layout(std430, binding = 0) readonly buffer BaseBlock {
    SrcSplat base[];
};

layout(std430, binding = 1) readonly buffer DeltaBlock {
    SrcSplat delta[];
};

layout(std430, binding = 2) writeonly buffer DecodedSplats {
    DstSplat decoded[];
};

uniform uint  u_count;
uniform float u_timeNorm;     // 4D blend in [0, 1]; 0 == static 3D
uniform uint  u_has4D;        // 0 / 1

vec2 unpackHalf(uint p) {
    return unpackHalf2x16(p);
}

void readSrc(SrcSplat s, out vec3 pos, out vec3 scale, out vec4 rot, out vec4 col) {
    vec2 p0 = unpackHalf(s.packed0.x);
    vec2 p1 = unpackHalf(s.packed0.y);
    vec2 p2 = unpackHalf(s.packed0.z);
    vec2 p3 = unpackHalf(s.packed0.w);
    vec2 p4 = unpackHalf(s.packed1.x);
    vec2 p5 = unpackHalf(s.packed1.y);
    vec2 p6 = unpackHalf(s.packed1.z);
    vec2 p7 = unpackHalf(s.packed1.w);
    vec2 p8 = unpackHalf(s.packed2.x);

    pos   = vec3(p0.x, p0.y, p1.x);
    scale = vec3(p1.y, p2.x, p2.y);
    rot   = vec4(p3.x, p3.y, p4.x, p4.y);
    col   = vec4(p5.x, p5.y, p6.x, p6.y);
    // p7, p8 reserved for SH coefficients; consumed when added.
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u_count) return;

    vec3 posB, scaleB, posD, scaleD;
    vec4 rotB, colB, rotD, colD;
    readSrc(base[i], posB, scaleB, rotB, colB);

    if (u_has4D != 0u) {
        readSrc(delta[i], posD, scaleD, rotD, colD);
        posB   += posD   * u_timeNorm;
        scaleB += scaleD * u_timeNorm;
        rotB    = normalize(mix(rotB, rotB + rotD, u_timeNorm));
        colB   += colD   * u_timeNorm;
    }

    DstSplat d;
    d.position = vec4(posB, 0.0);
    d.scale    = vec4(scaleB, colB.a);
    d.rotation = rotB;
    // Premultiply alpha for the raster blend mode.
    d.color    = vec4(colB.rgb * colB.a, colB.a);
    decoded[i] = d;
}
