{
  "name": "@viro-external/xr-contract",
  "version": "0.2.0",
  "description": "Vendor-neutral spatial surface, capability, portable scene, and interaction contracts for Viro platform adapters.",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md",
    "doc"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "type": "module",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
