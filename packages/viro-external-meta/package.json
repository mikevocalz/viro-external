{
  "name": "@viro-external/meta",
  "version": "0.1.0",
  "description": "Umbrella package for @viro-external/* — one install, one import surface.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "files": ["src", "doc", "AGENTS.md", "CLAUDE.md", "README.md"],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core.ts",
      "default": "./src/core.ts"
    },
    "./gui": {
      "types": "./src/gui.ts",
      "default": "./src/gui.ts"
    },
    "./bridge": {
      "types": "./src/bridge.ts",
      "default": "./src/bridge.ts"
    }
  },
  "dependencies": {
    "@viro-external/core": "workspace:*",
    "@viro-external/gui": "workspace:*",
    "react-native-viro-mux": "workspace:*"
  },
  "peerDependencies": {
    "@reactvision/react-viro": "2.56.0",
    "react": "*",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@reactvision/react-viro": "2.56.0",
    "@types/react": "*",
    "@viro-external/core": "workspace:*",
    "@viro-external/gui": "workspace:*",
    "react": "*",
    "react-native": "0.86.0",
    "react-native-viro-mux": "workspace:*",
    "typescript": "5.6.3"
  }
}
