// Eskiu-native math for spatial media presentation.
// Keep this ABI deliberately C-shaped so the render backend can consume it
// without exposing Eskiu layouts across the C++ boundary.

float vx_spatial_clamp01(float value) {
    if (value < 0.0) return 0.0;
    if (value > 1.0) return 1.0;
    return value;
}

float vx_spatial_lerp(float a, float b, float t) {
    return a + (b - a) * vx_spatial_clamp01(t);
}

float vx_spatial_smoothstep(float edge0, float edge1, float x) {
    if (edge0 == edge1) return 0.0;
    float t = vx_spatial_clamp01((x - edge0) / (edge1 - edge0));
    return t * t * (3.0 - 2.0 * t);
}

float vx_spatial_arc_radius(float width, float arc_radians) {
    if (width <= 0.0 || arc_radians <= 0.0) return 0.0;
    return (width * 0.5) / sin(arc_radians * 0.5);
}

float vx_spatial_arc_sagitta(float width, float arc_radians) {
    float radius = vx_spatial_arc_radius(width, arc_radians);
    if (radius == 0.0) return 0.0;
    return radius * (1.0 - cos(arc_radians * 0.5));
}

float vx_spatial_radial_layer(float base_radius, float toward_viewer) {
    return base_radius - toward_viewer;
}
