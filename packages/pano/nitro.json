{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["viropano"],
  "ios": {
    "iosModuleName": "NitroViroPano"
  },
  "android": {
    "androidNamespace": ["viropano"],
    "androidCxxLibName": "NitroViroPano"
  },
  "autolinking": {
    "PanoController": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridPanoController"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
